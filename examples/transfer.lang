-- The runners. mOf b is the measure of the bag b with the supply 100. trOf
-- f t q p rx z is the transfer, and trThen t e runs the transfer t on the
-- measure e (a none is a none before transfer). ctAt f s p is f of the
-- holding of s whose key is p (cpointEq of idKey, as holderAt), or
-- badProof when no holding has the key. own2 e gives the own of h, the own
-- of k (decryptIn under x_h and x_k) and the supply of e. hash4 e gives
-- the ctWords hash of the own and pub Ct of h, k, a and b, in that key
-- order, so the bag order does not change it.
def mOf : FreeMon Holding -> Except Measure :=
  fun (m : FreeMon Holding) => makeMeasure m (unitsOf 100) 0u

def trOf : Option Identity -> Option Identity -> Option (Prod Ct (Prod Ct Ct)) -> TransferProof -> U256 -> U256 -> Option Transfer :=
  fun (f : Option Identity) (t : Option Identity) (q : Option (Prod Ct (Prod Ct Ct))) (p : TransferProof) (rx : U256) (z : U256) => bind f (fun (d : Identity) => bind t (fun (e : Identity) => bind q (fun (c : Prod Ct (Prod Ct Ct)) => some (makeTransfer d e c p rx z))))

def trThen : Option Transfer -> Option (Except Measure) -> Option (Except Measure) :=
  fun (x : Option Transfer) (e : Option (Except Measure)) => bind cov (fun (n : Covenant) => bind x (fun (u : Transfer) => bind e (fun (r : Except Measure) => some (exBind Measure Measure r (fun (s : Measure) => transfer n s u)))))

def mH : Option (Except Measure) := bind holdH (fun (h : Holding) => some (mOf (fmEta Holding h)))

def mHA : Option (Except Measure) :=
  bind holdH (fun (h : Holding) => bind holdA (fun (a : Holding) => some (mOf (fmMul Holding (fmEta Holding h) (fmEta Holding a)))))

def ctAt : (Holding -> Ct) -> Measure -> CPoint -> Except Ct :=
  fun (f : Holding -> Ct) (s : Measure) (p : CPoint) => trOwnOf (fmChain Holding (Prod Flag (Prod CPoint CPoint)) (isSetProd Flag (Prod CPoint CPoint) flagIsSet (isSetProd CPoint CPoint cpointIsSet cpointIsSet)) (fun (b : Prod Flag (Prod CPoint CPoint)) (h : Holding) => flagIf (cpointEq (idKey (holdId h)) p) (pair flagYes (pair (ctC1 (f h)) (ctC2 (f h)))) b) (pair flagNo (pair (pair 0u 0u) (pair 0u 0u))) (holders s))

def unAt : Measure -> CPoint -> U256 -> Except Nat :=
  fun (s : Measure) (p : CPoint) (x : U256) => exBind Ct Nat (ctAt holdOwn s p) (fun (o : Ct) => exBind Units Nat (decryptIn (holderKey x) o) (fun (u : Units) => exEta Nat (unitsVal u)))

def own2 : Option (Except Measure) -> Option (Except (List Nat)) :=
  fun (e : Option (Except Measure)) => bind e (fun (r : Except Measure) => bind (ecMul g 11u) (fun (kh : CPoint) => bind (ecMul g 13u) (fun (kk : CPoint) => some (exBind Measure (List Nat) r (fun (s : Measure) => exBind Nat (List Nat) (unAt s kh 11u) (fun (a : Nat) => exBind Nat (List Nat) (unAt s kk 13u) (fun (b : Nat) => exEta (List Nat) (cons a (cons b (cons (unitsVal (supply s)) nil))))))))))

def ctHash : Measure -> List CPoint -> Except U256 :=
  fun (s : Measure) (ks : List CPoint) => fold (fun (p : CPoint) (r : Except U256) => exBind U256 U256 r (fun (w : U256) => exBind Ct U256 (ctAt holdOwn s p) (fun (o : Ct) => exBind Ct U256 (ctAt holdPub s p) (fun (u : Ct) => exEta U256 (ctWords (ctWords w o) u))))) (exEta U256 0u) ks

def keys4 : Option (List CPoint) :=
  bind (ecMul g 11u) (fun (a : CPoint) => bind (ecMul g 13u) (fun (b : CPoint) => bind (ecMul g 59u) (fun (c : CPoint) => bind (ecMul g 67u) (fun (e : CPoint) => some (cons a (cons b (cons c (cons e nil))))))))

def hash4 : Option (Except Measure) -> Option (Except U256) :=
  fun (e : Option (Except Measure)) => bind e (fun (r : Except Measure) => bind keys4 (fun (ks : List CPoint) => some (exBind Measure U256 r (fun (s : Measure) => ctHash s ks))))

def tG : Option Transfer := trOf (idOf 11u 23u) (idOf 13u 29u) qAll gProof rxG zG

def tL1 : Option Transfer := trOf (idOf 11u 23u) (idOf 13u 29u) (qOf 11u 13u 0 83u) l1Proof rxL1 zL1

def tL3b : Option Transfer :=
  trOf (idOf 11u 23u) (idOf 13u 29u) (qOf 11u 13u 7 103u) l3bProof rxL3b zL3b

def tL3c : Option Transfer :=
  trOf (idOf 11u 23u) (idOf 13u 29u) (qOf 11u 13u 12 127u) l3cProof rxL3c zL3c

def tL4 : Option Transfer :=
  trOf (idOf 59u 61u) (idOf 67u 71u) (qOf 59u 67u 9 149u) l4Proof rxL4 zL4

-- L1: a transfer of q 0 changes no balance: own h 50, own k 0 (the new
-- holding of k), supply 100.
-- Each row is a function xR of the start measure, applied to mH or mHA.
-- The checker evaluates a closed argument of an application, so the
-- form own2 (trThen tL1 mH) also runs the transfers at check time
-- (about 41 s for each transfer, B4-1).
def xL1 : Option (Except Measure) -> Option (Except (List Nat)) :=
  fun (m : Option (Except Measure)) => own2 (trThen tL1 m)

def trL1 : Option (Except (List Nat)) := xL1 mH

-- L3: the good transfer (q 5), then the L3b transfer (q 7) ...
def xL3a : Option (Except Measure) -> Option (Except (List Nat)) :=
  fun (m : Option (Except Measure)) => own2 (trThen tL3b (trThen tG m))

def trL3a : Option (Except (List Nat)) := xL3a mH

-- ... give the balances of one transfer of q 12: own h 38, own k 12,
-- supply 100.
def xL3b : Option (Except Measure) -> Option (Except (List Nat)) :=
  fun (m : Option (Except Measure)) => own2 (trThen tL3c m)

def trL3b : Option (Except (List Nat)) := xL3b mH

-- L4: the transfers h to k (q 5, gProof) and a to b (q 9) touch disjoint
-- holdings, so the 2 orders give the same own and pub Ct of h, k, a and b
-- (the same hash4).
def xL4ab : Option (Except Measure) -> Option (Except U256) :=
  fun (m : Option (Except Measure)) => hash4 (trThen tL4 (trThen tG m))

def trL4ab : Option (Except U256) := xL4ab mHA

-- The other order.
def xL4ba : Option (Except Measure) -> Option (Except U256) :=
  fun (m : Option (Except Measure)) => hash4 (trThen tG (trThen tL4 m))

def trL4ba : Option (Except U256) := xL4ba mHA
