-- tranche-lang S5 C12 (B4 r0, USER 11-04, form (b)): the transfer laws L1,
-- L3 and L4 as eval rows with literal proofs (L2 is the trkit row trL2). R
-- to qAll and the good chain catW to zG are the trkit fixtures, with the
-- same names and text: the covenant cov (keyOpenC ko, x_o 17), idOf x r
-- (an attested identity of key x G and class commitment claimCom 2 1 r),
-- holdH (the holding of h, x_h 11, r_h 23: own 50 under kh and pub 50
-- under ko, nonce 37), qAll (q 5 under kh, kk and ko, nonce 19), and
-- gProof with its signature rxG, zG (seed 7). holdA is the holding of a
-- (x_a 59, r_a 61): own 30 under ka and pub 30 under ko (nonce 73). qOf xf
-- xt m r is m under the keys of xf, xt and o with the nonce r. Each row
-- runs 2 transfers or fewer (about 82 s for each).
def R : Claims -> Claims -> Option Units :=
  fun (h : Claims) (k : Claims) => fold none (fold none (fold none (fold none (some (unitsOf 100)) (claimStatus k)) none (claimJuris k)) (claimStatus h)) none (claimJuris h)

def table : List (Prod (Prod Claims Claims) Units) := rTable R

def tableRows : Rows := rowsOf table

def cls : Claims := pair jurisB accredited

def other : Claims := pair jurisA accredited

def g : CPoint :=
  pair 0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798u 0x483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8u

def k0 : U256 := zkKey 0

def p0 : Option CPoint := ecMul g k0

def p1 : Option CPoint := ecMul g (zkKey 1)

def ring2 : Option (List CPoint) :=
  bind p0 (fun (a : CPoint) => bind p1 (fun (b : CPoint) => some (cons a (cons b nil))))

def idOf : U256 -> U256 -> Option Identity :=
  fun (x : U256) (r : U256) => bind ring2 (fun (rg : List CPoint) => bind (ecMul g x) (fun (k : CPoint) => bind (claimCom 2 1 r) (fun (c : CPoint) => bind (attestSign rg k0 k c) (fun (s : List U256) => some (makeIdentity k c rg s)))))

def cov : Option Covenant :=
  bind p0 (fun (a : CPoint) => bind p1 (fun (b : CPoint) => bind (ecMul g 17u) (fun (ko : CPoint) => some (makeCovenant (makePolity (fmUnit Point) 1 1 1 0u 0u) (fmCons CPoint a (fmCons CPoint b (fmUnit CPoint))) ko tableRows none))))

def holdH : Option Holding :=
  bind (idOf 11u 23u) (fun (d : Identity) => bind (ecMul g 11u) (fun (kh : CPoint) => bind (ecMul g 17u) (fun (ko : CPoint) => bind (ctEnc kh 50 (nonceOf 37u)) (fun (o : Ct) => bind (ctEnc ko 50 (nonceOf 37u)) (fun (p : Ct) => some (makeHolding d o p))))))

def qAll : Option (Prod Ct (Prod Ct Ct)) :=
  bind (ecMul g 11u) (fun (kh : CPoint) => bind (ecMul g 13u) (fun (kk : CPoint) => bind (ecMul g 17u) (fun (ko : CPoint) => bind (ctEnc kh 5 (nonceOf 19u)) (fun (qh : Ct) => bind (ctEnc kk 5 (nonceOf 19u)) (fun (qk : Ct) => bind (ctEnc ko 5 (nonceOf 19u)) (fun (qo : Ct) => some (pair qh (pair qk qo))))))))

def holdA : Option Holding :=
  bind (idOf 59u 61u) (fun (d : Identity) => bind (ecMul g 59u) (fun (ka : CPoint) => bind (ecMul g 17u) (fun (ko : CPoint) => bind (ctEnc ka 30 (nonceOf 73u)) (fun (o : Ct) => bind (ctEnc ko 30 (nonceOf 73u)) (fun (p : Ct) => some (makeHolding d o p))))))

def qOf : U256 -> U256 -> Nat -> U256 -> Option (Prod Ct (Prod Ct Ct)) :=
  fun (xf : U256) (xt : U256) (m : Nat) (r : U256) => bind (ecMul g xf) (fun (kf : CPoint) => bind (ecMul g xt) (fun (kt : CPoint) => bind (ecMul g 17u) (fun (ko : CPoint) => bind (ctEnc kf m (nonceOf r)) (fun (a : Ct) => bind (ctEnc kt m (nonceOf r)) (fun (b : Ct) => bind (ctEnc ko m (nonceOf r)) (fun (c : Ct) => some (pair a (pair b c))))))))

-- The good chain of trkit (gProof, rxG and zG), and catW, which joins the
-- parts of a literal.
def catW : List U256 -> List U256 -> List U256 :=
  fun (a : List U256) (b : List U256) => fold (fun (x : U256) (r : List U256) => cons x r) b a

