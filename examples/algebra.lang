-- Formers F6 and F7: fold over Nat and List; unfold with a step limit.
-- These rows stay on the kit List (S3): a fold of FreeMon into Nat needs
-- isSet Nat, sumTo feeds ones to sumList, and unfold has no FreeMon form.
def sumList : (xs : List Nat) -> Option Nat :=
  fun (xs : List Nat) => fold (fun (x : Nat) (acc : Option Nat) => bind acc (fun (a : Nat) => natAdd x a)) (some 0) xs

def square : (n : Nat) -> Option Nat :=
  fun (n : Nat) => bind (upTo 7 (fun (acc : Option Nat) => bind acc (fun (a : Nat) => natAdd a n)) (some 0) n) (fun (r : Option Nat) => r)

def ones : (n : Nat) -> List Nat := fun (n : Nat) => fold (fun (acc : List Nat) => cons 1 acc) nil n

def lengthOf : (xs : List Nat) -> Option Nat :=
  fun (xs : List Nat) => fold (fun (x : Nat) (acc : Option Nat) => bind acc (fun (a : Nat) => natAdd a 1)) (some 0) xs

def sumTo : Option Nat := sumList (ones 3)

def down : List Nat := unfold (fun (n : Nat) => map (fun (m : Nat) => pair n m) (natSub n 1)) 3 5

def stop : List Nat := unfold (fun (n : Nat) => none) 3 5

def capTwice : (n : Nat) -> Option Nat :=
  fun (n : Nat) => bind (upTo 4 (fun (acc : Option Nat) => bind acc (fun (a : Nat) => natAdd a 2)) (some 0) n) (fun (r : Option Nat) => r)

def capKeep : (n : Nat) -> Option Nat := fun (n : Nat) => upTo 3 (fun (a : Nat) => a) 7 n

def twos : (n : Nat) -> Option (List Nat) :=
  fun (n : Nat) => upTo 5 (fun (acc : List Nat) => cons 2 acc) nil n

def capLen : (n : Nat) -> Option Nat :=
  fun (n : Nat) => bind (twos n) (fun (xs : List Nat) => bind (upTo 3 (fun (x : Nat) (acc : Option Nat) => bind acc (fun (a : Nat) => natAdd x a)) (some 0) xs) (fun (r : Option Nat) => r))
