-- The amend cast (S6 C4, L15, Q-S6-13 and Q-S6-14 (a)): the ring (p0, p1)
-- of examples/zkcast.lang at poll 0. The members of the polity of cov are
-- the x words of the ring points (tAmend 1, no rows, no policy).
def g : CPoint :=
  pair 0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798u 0x483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8u

def k0 : U256 := zkKey 0

def k1 : U256 := zkKey 1

def p0 : Option CPoint := ecMul g k0

def p1 : Option CPoint := ecMul g k1

def p2 : Option CPoint := ecMul g (zkKey 2)

def ring : Option (List CPoint) :=
  bind p0 (fun (a : CPoint) => bind p1 (fun (b : CPoint) => some (cons a (cons b nil))))

-- outRing holds p2, and the x of p2 is not a member.
def outRing : Option (List CPoint) :=
  bind p0 (fun (a : CPoint) => bind p2 (fun (b : CPoint) => some (cons a (cons b nil))))

def poll : Digest := 0u

def cov : Option Covenant :=
  bind p0 (fun (a : CPoint) => bind p1 (fun (b : CPoint) => some (makeCovenant (makePolity (fmCons Point (first a) (fmCons Point (first b) (fmUnit Point))) 1 1 1 0u 0u) (fmCons CPoint a (fmCons CPoint b (fmUnit CPoint))) a (fmUnit (Prod (Prod Claims Claims) Units)) none)))

-- ballotOf ro k s v: the AmendBallot of v by the ring key k on the ring
-- ro, signed on the digest s and sealed under the amendTag on poll.
def ballotOf : Option (List CPoint) -> U256 -> Digest -> Verdict -> Option AmendBallot :=
  fun (ro : Option (List CPoint)) (k : U256) (s : Digest) (v : Verdict) => bind ro (fun (rg : List CPoint) => bind (zkSign rg k s amendChoice) (fun (sg : List U256) => mkAmend v rg sg poll))

-- castIn casts a ballot on poll into a box; boxSize counts the sealed ballots.
def castIn : Option Box -> Option AmendBallot -> Option Box :=
  fun (ob : Option Box) (oa : Option AmendBallot) => bind cov (fun (n : Covenant) => bind ob (fun (box : Box) => bind oa (fun (a : AmendBallot) => castAmend n poll a box)))

def box0 : Option Box := some (fmUnit SealedBallot)

def boxSize : Option Box -> Option Count :=
  fun (ob : Option Box) => bind ob (fun (box : Box) => fmChain SealedBallot (Option Count) optNatIsSet (fun (n : Option Count) (b : SealedBallot) => bind n opSucc) (some 0) box)

def y0 : Option AmendBallot := ballotOf ring k0 poll flagYes

def n0 : Option AmendBallot := ballotOf ring k0 poll flagNo

def y1 : Option AmendBallot := ballotOf ring k1 poll flagYes

-- The L15 rows: good and both cast; twice casts n0 after y0 (the same key
-- image); outsider signs on outRing; forged signs on 1u, not poll;
-- wrongTag seals y0 under the tag 5u, not the amendTag.
def good : Option Count := boxSize (castIn box0 y0)

def both : Option Count := boxSize (castIn (castIn box0 y0) y1)

def twice : Option Count := boxSize (castIn (castIn box0 y0) n0)

def outsider : Option Count := boxSize (castIn box0 (ballotOf outRing k0 poll flagYes))

def forged : Option Count := boxSize (castIn box0 (ballotOf ring k0 1u flagYes))

def wrongTag : Option Count :=
  boxSize (castIn box0 (bind ring (fun (rg : List CPoint) => bind (zkSign rg k0 poll amendChoice) (fun (sg : List U256) => some (pair (mkBallot flagYes 5u) (pair rg sg))))))

-- The tally law (S6 C5, L9 and L10) at two boxes of AmendBallots: the
-- opened tally of a box is the count of its decrypted votes, and open is
-- decrypt (L10). boxYY holds y0 and y1; boxYN holds y0 and no1, the no
-- of k1. govQ is the 1 of 2 quorum of the ring. Rule O7: open and
-- decrypt are law-only names, so the law rows are Path defs.
def no1 : Option AmendBallot := ballotOf ring k1 poll flagNo

def boxYY : Option Box := castIn (castIn box0 y0) y1

def boxYN : Option Box := castIn (castIn box0 y0) no1

def govQ : Quorum := quorum (szS sz0) (szS (szS sz0))

def lawTallyYY : Path (Option Count) (bind boxYY (fun (box : Box) => open (Option Count) govQ (tallyBox box))) (bind boxYY (fun (box : Box) => countVotes (fmMap SealedBallot Verdict (fun (b : SealedBallot) => decrypt Verdict (ballotVote b)) box))) :=
  refl

def lawTallyYN : Path (Option Count) (bind boxYN (fun (box : Box) => open (Option Count) govQ (tallyBox box))) (bind boxYN (fun (box : Box) => countVotes (fmMap SealedBallot Verdict (fun (b : SealedBallot) => decrypt Verdict (ballotVote b)) box))) :=
  refl

-- The opened tallies: boxYY has 2 yes votes and boxYN has 1. sizeYN
-- counts the two sealed ballots of boxYN, the yes and the no.
def tallyYY : Path (Option Count) (bind boxYY (fun (box : Box) => open (Option Count) govQ (tallyBox box))) (some 2) :=
  refl

def tallyYN : Path (Option Count) (bind boxYN (fun (box : Box) => open (Option Count) govQ (tallyBox box))) (some 1) :=
  refl

def sizeYN : Option Count := boxSize boxYN

-- The relabel law (S6 C6, L11, F9, Q-S6-6 (a)): a profile of k votes is
-- a configuration Pos k -> Sum Unit Unit (inl is yes, inr is no), and
-- profCount counts its yes votes. A relabel by a word of the action actW
-- keeps the count (orbit-lang law 1). prof2 is (yes, no) and swap2 swaps
-- its two positions. prof3 is (no, yes, no), and lift3 applies swap2 to
-- the tail, then swaps the first two positions.
def profCount : (k : Size) -> (Pos k -> Sum Unit Unit) -> Option Count :=
  fun (n : Size) => elim (fun (k : Size) => (Pos k -> Sum Unit Unit) -> Option Count) (fun (c : Pos sz0 -> Sum Unit Unit) => some 0) (fun (m : Size) (ih : (Pos m -> Sum Unit Unit) -> Option Count) (c : Pos (szS m) -> Sum Unit Unit) => either (fun (u : Unit) => bind (ih (fun (p : Pos m) => c (posNext m p))) opSucc) (fun (u : Unit) => ih (fun (p : Pos m) => c (posNext m p))) (c (posFirst m))) n

def size2 : Size := szS (szS sz0)

def size3 : Size := szS size2

def prof2 : Pos size2 -> Sum Unit Unit :=
  consP (szS sz0) (inl unit) (consP sz0 (inr unit) (fun (q : Pos sz0) => inl unit))

def prof3 : Pos size3 -> Sum Unit Unit := consP size2 (inr unit) prof2

def swap2 : Word size2 := wordSwap sz0 (wordNil size2)

def lift3 : Word size3 := wordLift size2 swap2 (wordSwap (szS sz0) (wordNil size3))

def lawRelabel2 : Path (Option Count) (profCount size2 (actW size2 swap2 prof2)) (profCount size2 prof2) :=
  refl

def lawRelabel3 : Path (Option Count) (profCount size3 (actW size3 lift3 prof3)) (profCount size3 prof3) :=
  refl

def relabel2 : Option Count := profCount size2 (actW size2 swap2 prof2)

def relabel3 : Option Count := profCount size3 (actW size3 lift3 prof3)

-- The legitimacy law (S6 C7, L12, Q-S6-6 (a)): decideC reads only the
-- count of a profile, so the decision factors through the orbits of
-- actW (OrbitN). decideP n c k d decides the amendment c of the
-- Covenant n at the yes count of d. The relabeled prof2 and prof2 give
-- one decision: cov needs 1 yes vote (tAmend 1) and has no policy, so
-- the decision is flagYes.
def decideP : Covenant -> Covenant -> (k : Size) -> (Pos k -> Sum Unit Unit) -> Flag :=
  fun (n : Covenant) (c : Covenant) (k : Size) (d : Pos k -> Sum Unit Unit) => option flagNo (fun (y : Count) => decideC n (pair c y)) (profCount k d)

def lawDecide : Path (Option Flag) (bind cov (fun (n : Covenant) => some (decideP n n size2 (actW size2 swap2 prof2)))) (bind cov (fun (n : Covenant) => some (decideP n n size2 prof2))) :=
  refl

def decideYN : Option Flag :=
  bind cov (fun (n : Covenant) => some (decideP n n size2 (actW size2 swap2 prof2)))

-- The Gov projection (S6 C9, Q-S6-2 (a)): covD is cov with the policy
-- some 1 (wRent). The W of covD keeps a rent of 100u and gives 0u for
-- a sale. cov has no policy, so GovPi gives none.
def covD : Option Covenant :=
  bind cov (fun (n : Covenant) => some (makeCovenant (polity n) (issuers n) (keyOpenC n) (covRows n) (some 1)))

def piRent : Option U256 :=
  bind covD (fun (n : Covenant) => bind (GovPi n) (fun (rw : Prod Rows W) => some (wApply (second rw) rent 100u)))

def piSale : Option U256 :=
  bind covD (fun (n : Covenant) => bind (GovPi n) (fun (rw : Prod Rows W) => some (wApply (second rw) sale 100u)))

def piNone : Option U256 :=
  bind cov (fun (n : Covenant) => bind (GovPi n) (fun (rw : Prod Rows W) => some (wApply (second rw) rent 100u)))

-- Self-constitution (S6 C10, L13, L16, Q-S6-5 (a)): covG is a closed
-- Covenant on the point g with the policy some 1, so its fate is
-- debreu 1 and AggOf of it is Unit. The empty ledger enacts nothing,
-- so (fmUnit CDecided, (unit, lawSelfG)) is a witness (L13). covN has
-- no policy: its fate is impossible, AggOf of it is Empty, and each
-- witness at covN gives an Empty (L16).
def covG : Covenant :=
  makeCovenant (makePolity (fmCons Point (first g) (fmUnit Point)) 1 1 1 0u 0u) (fmCons CPoint g (fmUnit CPoint)) g (fmUnit (Prod (Prod Claims Claims) Units)) (some 1)

def covN : Covenant :=
  makeCovenant (makePolity (fmCons Point (first g) (fmUnit Point)) 1 1 1 0u 0u) (fmCons CPoint g (fmUnit CPoint)) g (fmUnit (Prod (Prod Claims Claims) Units)) none

def lawSelfG : Path Covenant (Gov covG (fmUnit CDecided)) covG := refl

def selfG : IsSelfConstituting covG covG := pack (fmUnit CDecided) (pair unit lawSelfG)

def noSelfN : IsSelfConstituting covN covN -> Empty :=
  fun (w : IsSelfConstituting covN covN) => first (payload w)

-- The policy table (S6 C2, Q-S6-2 (a)): wApply of policyOf d at rent and
-- sale on 100u, for d = 0 (wAll), 1 (wRent) and 2 (out of the table, so
-- wZero). wHigh gives 200u for each inflow and the clamp gives the inflow,
-- so lawW is the W law W k a <= a at a = 100u.
def pol0Rent : U256 := wApply (policyOf 0) rent 100u

def pol0Sale : U256 := wApply (policyOf 0) sale 100u

def pol1Rent : U256 := wApply (policyOf 1) rent 100u

def pol1Sale : U256 := wApply (policyOf 1) sale 100u

def pol2Rent : U256 := wApply (policyOf 2) rent 100u

def pol2Sale : U256 := wApply (policyOf 2) sale 100u

def wHigh : W := wOf (fun (k : Kind) (a : U256) => 200u)

def highRent : U256 := wApply wHigh rent 100u

def lawW : Path Flag (u256Le (wApply wHigh rent 100u) 100u) flagYes := refl

-- The Covenant amend (S6 C3, Q-S6-1 (a)) and the fate (S6 C8, PLAN 4.3
-- Fate): covZ is covG with the policy some 0 (wAll), and covBad is covG
-- with the policy some 5 (out of the table). covG has tAmend 1, so amPass
-- (one yes vote) enacts covZ, and amLow (no yes vote) and amBad
-- (policyKnown 5 is flagNo) keep covG. l8C is L8 for amendC (no
-- Measure): one yes vote enacts each Covenant with the policy some 0.
def covZ : Covenant :=
  makeCovenant (polity covG) (issuers covG) (keyOpenC covG) (covRows covG) (some 0)

def covBad : Covenant :=
  makeCovenant (polity covG) (issuers covG) (keyOpenC covG) (covRows covG) (some 5)

def amPass : Covenant := Gov covG (fmCons CDecided (pair covZ 1) (fmUnit CDecided))

def amLow : Covenant := Gov covG (fmCons CDecided (pair covZ 0) (fmUnit CDecided))

def amBad : Covenant := Gov covG (fmCons CDecided (pair covBad 1) (fmUnit CDecided))

def polPass : Option D := covPolicy amPass

def polLow : Option D := covPolicy amLow

def polBad : Option D := covPolicy amBad

def fateG : Fate := fateOf covG

def fateN : Fate := fateOf covN

def fatePass : Fate := fateOf amPass

def l8C : (c : Covenant) -> Path Covenant (Gov covG (fmCons CDecided (pair (makeCovenant (polity c) (issuers c) (keyOpenC c) (covRows c) (some 0)) 1) (fmUnit CDecided))) (makeCovenant (polity c) (issuers c) (keyOpenC c) (covRows c) (some 0)) :=
  fun (c : Covenant) => refl

-- L14 (S6 C11, F8): amendC folds the left factor first (the l9 law of
-- examples/polity.lang on the Covenant), and amend is Gov.
def l9C : (ps : FreeMon CDecided) -> (qs : FreeMon CDecided) -> (n : Covenant) -> Path Covenant (amendC n (fmMul CDecided ps qs)) (amendC (amendC n ps) qs) :=
  fun (ps : FreeMon CDecided) (qs : FreeMon CDecided) (n : Covenant) => refl

def lawAmendGov : (n : Covenant) -> (L : FreeMon CDecided) -> Path Covenant (amendC n L) (Gov n L) :=
  fun (n : Covenant) (L : FreeMon CDecided) => refl

-- G5 (S6 C13, PLAN G5, L16, L14, Q-S6-18 (a)): no policy in force, then
-- the polity amends tAmend, issuers and policy. distOf n k a is the part
-- of the inflow a of the kind k that the policy in force distributes
-- (GovPi), and keepOf n k a is the part that stays in the treasury
-- (u256Sub is partial, so an Option; the W clamp makes it some). issN
-- counts the issuers (natAdd is partial, so an Option Nat). covN
-- has no policy, so its fate is impossible: distOf gives 0u and keepOf
-- gives the whole inflow (L16). The distribute and Treasury rows on a
-- Measure are S7 (Part P). covA is covN with tAmend 2, the issuers iss2
-- (the point 2 G) and g, and the policy some 0 (wAll). covN has tAmend
-- 1, so the one yes vote of g5L1 enacts covA (g5A). Under covA the
-- amendment g5L2 back to covN has one yes vote, below tAmend 2, so the
-- fold of g5L1 then g5L2 keeps covA (g5B, lawG5, L14).
def distOf : Covenant -> Kind -> U256 -> U256 :=
  fun (n : Covenant) (k : Kind) (a : U256) => option 0u (fun (rw : Prod Rows W) => wApply (second rw) k a) (GovPi n)

def keepOf : Covenant -> Kind -> U256 -> Option U256 :=
  fun (n : Covenant) (k : Kind) (a : U256) => u256Sub a (distOf n k a)

def issN : Covenant -> Option Nat :=
  fun (n : Covenant) => fmChain CPoint (Option Nat) optNatIsSet (fun (c : Option Nat) (p : CPoint) => bind c (fun (m : Nat) => natAdd m 1)) (some 0) (issuers n)

def iss2 : CPoint :=
  pair 0xc6047f9441ed7d6d3045406e95c07cd85c778e4b8cef3ca7abac09b95c709ee5u 0x1ae168fea63dc339a3c58419466ceaeef7f632653266d0e1236431a950cfe52au

def covA : Covenant :=
  makeCovenant (makePolity (members (polity covN)) 1 2 1 0u 0u) (fmCons CPoint iss2 (issuers covN)) (keyOpenC covN) (covRows covN) (some 0)

def g5L1 : FreeMon CDecided := fmCons CDecided (pair covA 1) (fmUnit CDecided)

def g5L2 : FreeMon CDecided := fmCons CDecided (pair covN 1) (fmUnit CDecided)

def g5A : Covenant := Gov covN g5L1

def g5B : Covenant := Gov covN (fmMul CDecided g5L1 g5L2)

def lawG5 : Path Covenant (Gov covN (fmMul CDecided g5L1 g5L2)) covA := refl

def g5Dist : U256 := distOf covN rent 100u

def g5Keep : Option U256 := keepOf covN rent 100u

def g5Fate : Fate := fateOf g5A

def g5TAmend : Nat := tAmend (polity g5A)

def g5Iss : Option Nat := issN g5A

def g5DistA : U256 := distOf g5A sale 100u

def g5KeepA : Option U256 := keepOf g5A sale 100u

def g5FateB : Fate := fateOf g5B

def g5TAmendB : Nat := tAmend (polity g5B)

-- Opposite scalar, same x-only member, distinct key image. The upper-y
-- representative must be refused both alone and after the valid ballot.
def negK0 : Option U256 :=
  u256Sub 0xfffffffffffffffffffffffffffffffebaaedce6af48a03bbfd25e8cd0364141u k0

def negRing : Option (List CPoint) :=
  bind negK0 (fun (k : U256) => bind (ecMul g k) (fun (p : CPoint) => some (cons p nil)))

def opposite : Option Count :=
  boxSize (castIn (castIn box0 y0) (bind negK0 (fun (k : U256) => ballotOf negRing k poll flagYes)))

def oppositeAlone : Option Count :=
  boxSize (castIn box0 (bind negK0 (fun (k : U256) => ballotOf negRing k poll flagYes)))
