-- tranche-lang S5 C9 (B3-13): the transfer kit words on a table with one
-- class. R admits only the self pair ((jurisB, accredited), cap 100), so
-- c = 1, and m = 1. st holds the keys of h, k and o (x_h 11, x_k 13, x_o
-- 17), the class commitments of h and k (claimCom 2 1, r_h 23, r_k 29),
-- q = 5 under each of the 3 keys with the one nonce r = 19, and the own
-- balance 50 under the key of h (nonce 37). The C10 good transfer row
-- holds the proof of the good chain (jrSend, jrSelect, jrOpen,
-- transferProve) as literal words (USER 11-03), so it runs transferVerify
-- only. It is the one expensive row, and each other row is cheap. A C9
-- row gives 0 for some (flagYes for a verifier), 1 for a none of
-- the last word, 2 for some flagNo, 3 for a none of issueProve, and 9 for
-- a none before the words.
def R : Claims -> Claims -> Option Units :=
  fun (h : Claims) (k : Claims) => fold none (fold none (fold none (fold none (some (unitsOf 100)) (claimStatus k)) none (claimJuris k)) (claimStatus h)) none (claimJuris h)

def table : List (Prod (Prod Claims Claims) Units) := rTable R

def cls : Claims := pair jurisB accredited

def other : Claims := pair jurisA accredited

def g : CPoint :=
  pair 0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798u 0x483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8u

def st : Option (Prod CPoint (Prod CPoint (Prod CPoint (Prod CPoint (Prod CPoint (Prod Ct (Prod Ct (Prod Ct Ct)))))))) :=
  bind (ecMul g 11u) (fun (kh : CPoint) => bind (ecMul g 13u) (fun (kk : CPoint) => bind (ecMul g 17u) (fun (ko : CPoint) => bind (claimCom 2 1 23u) (fun (ch : CPoint) => bind (claimCom 2 1 29u) (fun (ck : CPoint) => bind (ctEnc kh 5 (nonceOf 19u)) (fun (qh : Ct) => bind (ctEnc kk 5 (nonceOf 19u)) (fun (qk : Ct) => bind (ctEnc ko 5 (nonceOf 19u)) (fun (qo : Ct) => bind (ctEnc kh 50 (nonceOf 37u)) (fun (oh : Ct) => some (pair kh (pair kk (pair ko (pair ch (pair ck (pair qh (pair qk (pair qo oh)))))))))))))))))

def onSt : (Prod CPoint (Prod CPoint (Prod CPoint (Prod CPoint (Prod CPoint (Prod Ct (Prod Ct (Prod Ct Ct))))))) -> Nat) -> Nat :=
  fun (f : Prod CPoint (Prod CPoint (Prod CPoint (Prod CPoint (Prod CPoint (Prod Ct (Prod Ct (Prod Ct Ct))))))) -> Nat) => option 9 f st

def proved : Option (List U256) -> Nat :=
  fun (o : Option (List U256)) => option 1 (fun (p : List U256) => 0) o

def checked : Option Flag -> Nat :=
  fun (o : Option Flag) => option 1 (fun (v : Flag) => flagIf v 0 2) o

-- jrSend on a class that is not the class of h: no M1.
def sendClass : Nat :=
  onSt (fun (s : Prod CPoint (Prod CPoint (Prod CPoint (Prod CPoint (Prod CPoint (Prod Ct (Prod Ct (Prod Ct Ct)))))))) => proved (jrSend table other s (unitsOf 5) (cons 19u (cons 23u (cons 31u nil)))))

-- jrSend on a secrets list without the seed: no M1.
def sendShort : Nat :=
  onSt (fun (s : Prod CPoint (Prod CPoint (Prod CPoint (Prod CPoint (Prod CPoint (Prod Ct (Prod Ct (Prod Ct Ct)))))))) => proved (jrSend table cls s (unitsOf 5) (cons 19u (cons 23u nil))))

-- jrSelect (M2) on a nil M1: no M2.
def selectNil : Nat :=
  onSt (fun (s : Prod CPoint (Prod CPoint (Prod CPoint (Prod CPoint (Prod CPoint (Prod Ct (Prod Ct (Prod Ct Ct)))))))) => proved (jrSelect table cls s nil (cons 29u (cons 13u (cons 41u nil)))))

-- jrOpen (M3) on a nil M1 and a nil M2: no M3.
def openNil : Nat :=
  onSt (fun (s : Prod CPoint (Prod CPoint (Prod CPoint (Prod CPoint (Prod CPoint (Prod Ct (Prod Ct (Prod Ct Ct)))))))) => proved (jrOpen table s nil nil (cons 11u nil)))

-- transferProve when the own balance 4 is less than q = 5: no proof.
def proveOver : Nat :=
  onSt (fun (s : Prod CPoint (Prod CPoint (Prod CPoint (Prod CPoint (Prod CPoint (Prod Ct (Prod Ct (Prod Ct Ct)))))))) => proved (transferProve s (unitsOf 5) (unitsOf 4) (cons 19u (cons 11u (cons 43u nil)))))

-- transferProve on a secrets list with r only: no proof.
def proveShort : Nat :=
  onSt (fun (s : Prod CPoint (Prod CPoint (Prod CPoint (Prod CPoint (Prod CPoint (Prod Ct (Prod Ct (Prod Ct Ct)))))))) => proved (transferProve s (unitsOf 5) (unitsOf 50) (cons 19u nil)))

-- transferVerify on nil proof lists: no flagYes.
def verifyNil : Nat :=
  onSt (fun (s : Prod CPoint (Prod CPoint (Prod CPoint (Prod CPoint (Prod CPoint (Prod Ct (Prod Ct (Prod Ct Ct)))))))) => checked (transferVerify table s (pair nil (pair nil (pair nil nil)))))

-- The issue pair, o (x_o 17) to h (x_h 11): issueProve, then issueVerify.
-- co and ci hold m = 7 (r_o 47, r_i 53). pm is the m of the proof, vm the
-- m of the check, sec the secrets list.
def issRun : Units -> Units -> List U256 -> Nat :=
  fun (pm : Units) (vm : Units) (sec : List U256) => option 9 (fun (ko : CPoint) => option 9 (fun (kh : CPoint) => option 9 (fun (co : Ct) => option 9 (fun (ci : Ct) => option 3 (fun (pf : List U256) => checked (issueVerify ko kh (pair co ci) vm pf)) (issueProve ko kh (pair co ci) pm sec)) (ctEnc kh 7 (nonceOf 53u))) (ctEnc ko 7 (nonceOf 47u))) (ecMul g 11u)) (ecMul g 17u)

def iss : Nat := issRun (unitsOf 7) (unitsOf 7) (cons 47u (cons 53u nil))

-- The proof of m = 7, checked against m = 8: no flagYes.
def issOff : Nat := issRun (unitsOf 7) (unitsOf 8) (cons 47u (cons 53u nil))

-- A proof of m = 8 on the 2 Ct that hold 7: issueVerify rejects the proof.
def issLie : Nat := issRun (unitsOf 8) (unitsOf 8) (cons 47u (cons 53u nil))

-- A secrets list without r_i: issueProve refuses.
def issShort : Nat := issRun (unitsOf 7) (unitsOf 7) (cons 47u nil)

-- The C10 transfer rows (B3-10, B3-26 to B3-34). The covenant cov has the
-- attestors p0 and p1 (zkKey 0 and zkKey 1), keyOpenC ko (x_o 17) and the
-- rows table. idOf x r is an identity of key x G and com claimCom 2 1 r
-- with an attestation of p0 on the ring (p0, p1). bareOf x r has none.
-- holdH is the one holding of h (x_h 11, r_h 23): own 50 under kh and pub
-- 50 under ko (nonce 37). qAll is q = 5 under kh, kk and ko (nonce 19), so
-- trSt of each row is st. trRun b f t p rx z runs transfer on the measure
-- of the bag b (fmEta holdH) and gives the number of holdings after it, or
-- the failure. A none is a none before transfer. (rx, z) are literal words
-- of the host FROST signer (1 of 1, share x_h 11, B3-33): rxN and zN sign
-- (m0, 0u), with m0 = trDigest st and 0u = trProofDigest nilPf (seed 8).
def k0 : U256 := zkKey 0

def p0 : Option CPoint := ecMul g k0

def p1 : Option CPoint := ecMul g (zkKey 1)

def ring2 : Option (List CPoint) :=
  bind p0 (fun (a : CPoint) => bind p1 (fun (b : CPoint) => some (cons a (cons b nil))))

def idOf : U256 -> U256 -> Option Identity :=
  fun (x : U256) (r : U256) => bind ring2 (fun (rg : List CPoint) => bind (ecMul g x) (fun (k : CPoint) => bind (claimCom 2 1 r) (fun (c : CPoint) => bind (attestSign rg k0 k c) (fun (s : List U256) => some (makeIdentity k c rg s)))))

def bareOf : U256 -> U256 -> Option Identity :=
  fun (x : U256) (r : U256) => bind ring2 (fun (rg : List CPoint) => bind (ecMul g x) (fun (k : CPoint) => bind (claimCom 2 1 r) (fun (c : CPoint) => some (makeIdentity k c rg nil))))

def cov : Option Covenant :=
  bind p0 (fun (a : CPoint) => bind p1 (fun (b : CPoint) => bind (ecMul g 17u) (fun (ko : CPoint) => some (makeCovenant (makePolity (fmUnit Point) 1 1 1 0u 0u) (fmCons CPoint a (fmCons CPoint b (fmUnit CPoint))) ko table))))

def holdH : Option Holding :=
  bind (idOf 11u 23u) (fun (d : Identity) => bind (ecMul g 11u) (fun (kh : CPoint) => bind (ecMul g 17u) (fun (ko : CPoint) => bind (ctEnc kh 50 (nonceOf 37u)) (fun (o : Ct) => bind (ctEnc ko 50 (nonceOf 37u)) (fun (p : Ct) => some (makeHolding d o p))))))

def qAll : Option (Prod Ct (Prod Ct Ct)) :=
  bind (ecMul g 11u) (fun (kh : CPoint) => bind (ecMul g 13u) (fun (kk : CPoint) => bind (ecMul g 17u) (fun (ko : CPoint) => bind (ctEnc kh 5 (nonceOf 19u)) (fun (qh : Ct) => bind (ctEnc kk 5 (nonceOf 19u)) (fun (qk : Ct) => bind (ctEnc ko 5 (nonceOf 19u)) (fun (qo : Ct) => some (pair qh (pair qk qo))))))))

def trRun : (FreeMon Holding -> FreeMon Holding) -> Option Identity -> Option Identity -> TransferProof -> U256 -> U256 -> Option (Except Nat) :=
  fun (b : FreeMon Holding -> FreeMon Holding) (f : Option Identity) (t : Option Identity) (p : TransferProof) (rx : U256) (z : U256) => bind cov (fun (n : Covenant) => bind holdH (fun (h : Holding) => bind f (fun (d : Identity) => bind t (fun (e : Identity) => bind qAll (fun (q : Prod Ct (Prod Ct Ct)) => some (exBind Measure Nat (makeMeasure (b (fmEta Holding h)) (unitsOf 100) 0u) (fun (s : Measure) => exBind Measure Nat (transfer n s (makeTransfer d e q p rx z)) (fun (r : Measure) => option (exFail Nat overflow) (fun (c : Nat) => exEta Nat c) (len Holding (holders r))))))))))

def bagId : FreeMon Holding -> FreeMon Holding := fun (m : FreeMon Holding) => m

-- dbl doubles a bag, so big (fmEta holdH) holds 2^10 = 1024 holdings.
def dbl : FreeMon Holding -> FreeMon Holding := fun (m : FreeMon Holding) => fmMul Holding m m

def big : FreeMon Holding -> FreeMon Holding :=
  fun (m : FreeMon Holding) => dbl (dbl (dbl (dbl (dbl (dbl (dbl (dbl (dbl (dbl m)))))))))

def nilPf : TransferProof := pair nil (pair nil (pair nil nil))

def rxN : U256 := 0xe8c4b7791a89528519ea87f22a6ba9f1ce02b2f2d92c817e1f235814cf0dd173u

def zN : U256 := 0x7ebd587a750312bc5865fa39d7fe685acb69e44577f0dfedc5901d1a9a8cfd04u

-- from has no attestation: badAttest.
def trFromBare : Option (Except Nat) := trRun bagId (bareOf 11u 23u) (idOf 13u 29u) nilPf rxN zN

-- to has no attestation: badAttest.
def trToBare : Option (Except Nat) := trRun bagId (idOf 11u 23u) (bareOf 13u 29u) nilPf rxN zN

-- from (key k) holds nothing: badProof.
def trNoHold : Option (Except Nat) := trRun bagId (idOf 13u 29u) (idOf 11u 23u) nilPf rxN zN

-- z is not the z of the signature: badSig.
def trBadSig : Option (Except Nat) := trRun bagId (idOf 11u 23u) (idOf 13u 29u) nilPf rxN 1u

-- 1024 holdings and a new to: full (after the signature check).
def trFull : Option (Except Nat) := trRun big (idOf 11u 23u) (idOf 13u 29u) nilPf rxN zN

-- The signature holds, and transferVerify refuses the nil proof: badProof.
def trNilPf : Option (Except Nat) := trRun bagId (idOf 11u 23u) (idOf 13u 29u) nilPf rxN zN

-- The good transfer. gPf, gM1, gM2 and gM3 are the transferProve, jrSend,
-- jrSelect and jrOpen outputs of the good chain (the secrets of this file),
-- as literal words (b3-r13-print.lang printed them). The parser refuses
-- terms that nest deeper than 1000 levels, so a literal has 400 words or
-- less and catW joins the parts. rxG and zG sign (m0, m1) with seed 7.
def catW : List U256 -> List U256 -> List U256 :=
  fun (a : List U256) (b : List U256) => fold (fun (x : U256) (r : List U256) => cons x r) b a

