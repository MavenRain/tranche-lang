-- A guest elim over a run-time Word (cairn-lang S9, PLAN O26, Q-S9-11).
-- wordLift has 2 recursive fields and no interval, so an elim (limit 1)
-- gives the second REFUSE_RUNTIME_TREE of src/front/lower.c (family_fold).
-- The motive is Option Nat (no function), so no closure refusal comes
-- first; the gate checks it.
def t : (n : Nat) -> Option Nat :=
  fun (n : Nat) => elim (fun (k : Size) (v : Word k) => Option Nat) (fun (m : Size) => some 0) (fun (m : Size) (r : Word (szS (szS m))) (ihr : Option Nat) => ihr) (fun (m : Size) (inn : Word m) (ihi : Option Nat) (r : Word (szS m)) (ihr : Option Nat) => bind ihi (fun (a : Nat) => bind ihr (fun (b : Nat) => natAdd a b))) (fold (fun (w : Word (szS sz0)) => wordLift sz0 (wordNil sz0) w) (wordNil (szS sz0)) n)
