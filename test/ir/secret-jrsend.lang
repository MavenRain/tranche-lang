-- The build refuses jrSend (tranche-lang S5 C9, B3-13): the secrets list
-- holds the nonce r, the blinding of the class commitment and the seed, so
-- no target has the operation (REFUSE_TARGET_SECRET).
def t0 : Rows := fmUnit (Prod (Prod Claims Claims) Units)

def g : CPoint :=
  pair 0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798u 0x483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8u

-- The Ct is ctOf g g, not a ctEnc, so jrSend is the one secret op here.
def c0 : Ct := ctOf g g

def send : Nat :=
  option 1 (fun (m1 : List U256) => 0) (jrSend t0 (pair jurisB accredited) (pair g (pair g (pair g (pair g (pair g (pair c0 (pair c0 (pair c0 c0)))))))) (unitsOf 5) (cons 19u (cons 23u (cons 31u nil))))
