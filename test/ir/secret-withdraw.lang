-- The build refuses withdrawProve (tranche-lang S7 C5, Q-S7-4 (a)): the
-- secrets list holds mu, the secret key x_h and the seed, so no target
-- has the operation (REFUSE_TARGET_SECRET).
def g : CPoint :=
  pair 0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798u 0x483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8u

-- The Ct is ctOf g g, not a ctEnc, so withdrawProve is the one secret op
-- here.
def c0 : Ct := ctOf g g

def prove : Nat :=
  option 1 (fun (p : List U256) => 0) (withdrawProve g c0 5u (cons 19u (cons 23u (cons 31u nil))))
