-- The build refuses claimCom on a run-time blinding r (tranche-lang S4
-- C4, O4): the opening (juris, status, r) of a claim is secret, so no
-- target has the operation (REFUSE_TARGET_SECRET).
def comX : (r : U256) -> Option U256 :=
  fun (r : U256) => bind (claimCom 1 0 r) (fun (p : Prod U256 U256) => some (first p))
