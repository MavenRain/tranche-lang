-- The digit fold 3d + a over the leaves of the old binary node records
-- (cairn-lang S8, Q-S8-10, Q-S8-11), one upTo 7 fold each (C9b2: the
-- fmChain and fmRun walks have no static bound). Each step adds the leaves
-- 1, 2 at the end (snoc), 3, 4 at the front (cons), or 1 at the front and
-- 2 at the end (mix). Chain reads the leaves left to right and run right to
-- left. 3d + a is not symmetric, so a swapped side or order gives a
-- different value. mix keeps the state (9^k, x). The gate compares langc
-- eval results.
def digit : (d : Nat) -> (a : Nat) -> Option Nat :=
  fun (d : Nat) (a : Nat) => bind (natAdd d d) (fun (e : Nat) => bind (natAdd e d) (fun (t : Nat) => natAdd t a))

def snocChain : (n : Nat) -> Option Nat :=
  fun (n : Nat) => bind (upTo 7 (fun (acc : Option Nat) => bind acc (fun (d : Nat) => bind (digit d 1) (fun (e : Nat) => digit e 2))) (some 0) n) (fun (r : Option Nat) => r)

def snocRun : (n : Nat) -> Option Nat :=
  fun (n : Nat) => bind (upTo 7 (fun (acc : Option Nat) => bind acc (fun (d : Nat) => bind (digit d 2) (fun (e : Nat) => digit e 1))) (some 0) n) (fun (r : Option Nat) => r)

def consChain : (n : Nat) -> Option Nat :=
  fun (n : Nat) => bind (upTo 7 (fun (acc : Option Nat) => bind acc (fun (d : Nat) => bind (digit d 3) (fun (e : Nat) => digit e 4))) (some 0) n) (fun (r : Option Nat) => r)

def consRun : (n : Nat) -> Option Nat :=
  fun (n : Nat) => bind (upTo 7 (fun (acc : Option Nat) => bind acc (fun (d : Nat) => bind (digit d 4) (fun (e : Nat) => digit e 3))) (some 0) n) (fun (r : Option Nat) => r)

def mixChain : (n : Nat) -> Option Nat :=
  fun (n : Nat) => bind (upTo 7 (fun (s : Option (Prod Nat Nat)) => bind s (fun (p : Prod Nat Nat) => bind (digit (first p) 0) (fun (h : Nat) => bind (digit h 0) (fun (q : Nat) => bind (natAdd (first p) (second p)) (fun (y : Nat) => map (fun (x : Nat) => pair q x) (digit y 2)))))) (some (pair 1 0)) n) (fun (s : Option (Prod Nat Nat)) => map (fun (p : Prod Nat Nat) => second p) s)

def mixRun : (n : Nat) -> Option Nat :=
  fun (n : Nat) => bind (upTo 7 (fun (s : Option (Prod Nat Nat)) => bind s (fun (p : Prod Nat Nat) => bind (digit (first p) 0) (fun (h : Nat) => bind (digit h 0) (fun (q : Nat) => bind (natAdd (first p) (first p)) (fun (w : Nat) => bind (natAdd w (second p)) (fun (y : Nat) => map (fun (x : Nat) => pair q x) (digit y 1))))))) (some (pair 1 0)) n) (fun (s : Option (Prod Nat Nat)) => map (fun (p : Prod Nat Nat) => second p) s)

def snocLen : (n : Nat) -> Option Nat :=
  fun (n : Nat) => bind (upTo 7 (fun (acc : Option Nat) => bind acc (fun (a : Nat) => natAdd a 2)) (some 0) n) (fun (r : Option Nat) => r)
