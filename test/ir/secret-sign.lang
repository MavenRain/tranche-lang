-- A signature made with a secret key must not reach a target (cairn-lang
-- S9, Q-S9-3, PLAN O6): the build refuses zkSign on a run-time poll id
-- (REFUSE_TARGET_SECRET). The ring and the key are as in examples/zk.lang.
def g : Prod U256 U256 :=
  pair 0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798u 0x483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8u

def ring : Option (List (Prod U256 U256)) :=
  bind (ecMul g (zkKey 0)) (fun (a : Prod U256 U256) => bind (ecMul g (zkKey 1)) (fun (b : Prod U256 U256) => some (cons a (cons b nil))))

def sigLen : (n : Nat) -> Option Nat :=
  fun (n : Nat) => bind ring (fun (rg : List (Prod U256 U256)) => bind (zkSign rg (zkKey 0) (toU256 n) 1u) (fun (sg : List U256) => fold (fun (w : U256) (acc : Option Nat) => bind acc (fun (a : Nat) => natAdd a 1)) (some 0) sg))
