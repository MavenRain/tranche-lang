-- The spine lowerings. Each list here exists only at run time, so
-- `langc ir` walks its spine. Each entry is one upTo 7 fold over a list
-- (none above 7 items). The gate compares `langc eval` results.
def noNats : List Nat := nil

-- The list 1, 2, ..., n, at most 8 items (the unfold limit).
def upFrom : (n : Nat) -> List Nat :=
  fun (n : Nat) => unfold (fun (k : Nat) => flagIf (natLe k n) (map (fun (j : Nat) => pair k j) (natAdd k 1)) none) 8 1

-- At seed 3 the step gives none (natAdd overflows), so the list ends there.
def upTrap : (n : Nat) -> List Nat :=
  fun (n : Nat) => unfold (fun (k : Nat) => flagIf (natLe k n) (flagIf (natEq k 3) (map (fun (c : Nat) => pair c c) (natAdd 18446744073709551615 1)) (map (fun (j : Nat) => pair k j) (natAdd k 1))) none) 8 1

def foldOnes : (n : Nat) -> Option Nat :=
  fun (n : Nat) => bind (upTo 7 (fun (x : Nat) (acc : Option Nat) => bind acc (fun (a : Nat) => natAdd 2 a)) (some 0) (upFrom n)) (fun (r : Option Nat) => r)

def mapUp : (n : Nat) -> Option Nat :=
  fun (n : Nat) => bind (upTo 7 (fun (x : Nat) (acc : Option Nat) => bind (bind (natAdd x x) (fun (y : Nat) => natAdd y x)) (fun (b : Nat) => bind acc (fun (a : Nat) => natAdd b a))) (some 0) (upFrom n)) (fun (r : Option Nat) => r)

def bindUp : (n : Nat) -> Option Nat :=
  fun (n : Nat) => bind (upTo 7 (fun (x : Nat) (acc : Option Nat) => bind acc (fun (a : Nat) => bind (natAdd 10 a) (fun (c : Nat) => natAdd x c))) (some 0) (upFrom n)) (fun (r : Option Nat) => r)

def filterUp : (n : Nat) -> Option Nat :=
  fun (n : Nat) => bind (upTo 7 (fun (x : Nat) (acc : Option Nat) => flagIf (natLe x 2) (bind acc (fun (a : Nat) => natAdd x a)) acc) (some 0) (upFrom n)) (fun (r : Option Nat) => r)

def trapHead : (n : Nat) -> Option Nat :=
  fun (n : Nat) => upTo 7 (fun (x : Nat) (acc : Nat) => x) 0 (upTrap n)

def trapSum : (n : Nat) -> Option Nat :=
  fun (n : Nat) => bind (upTo 7 (fun (x : Nat) (acc : Option Nat) => bind acc (fun (a : Nat) => natAdd x a)) (some 0) (upTrap n)) (fun (r : Option Nat) => r)

-- The test of item 3 reads a none (natAdd overflows): flagNo.
def filterTrap : (n : Nat) -> Option Nat :=
  fun (n : Nat) => bind (upTo 7 (fun (x : Nat) (acc : Option Nat) => flagIf (flagIf (natEq x 3) (option flagNo (fun (s : Nat) => natEq s 0) (natAdd 18446744073709551615 1)) (natLe x 5)) (bind acc (fun (a : Nat) => natAdd x a)) acc) (some 0) (upFrom n)) (fun (r : Option Nat) => r)

-- The step for item 2 reads a none (natAdd overflows): it keeps acc.
def bindTrap : (n : Nat) -> Option Nat :=
  fun (n : Nat) => upTo 7 (fun (x : Nat) (acc : Nat) => flagIf (natEq x 2) (option acc (fun (c : Nat) => c) (natAdd 18446744073709551615 1)) x) 0 (upFrom n)
