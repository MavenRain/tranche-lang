-- transferVerify has no target form until S8 (tranche-lang S5 C9,
-- B3-13): a run-time state gives REFUSE_LOWER (HOST-LIMIT, a host proof
-- check). The Ct is ctOf g g, not a ctEnc, so no secret op comes first.
def t0 : List (Prod (Prod Claims Claims) Units) := nil

def g : CPoint :=
  pair 0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798u 0x483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8u

def c0 : Ct := ctOf g g

def ok : (x : U256) -> Option Flag :=
  fun (x : U256) => transferVerify t0 (pair (pair x x) (pair g (pair g (pair g (pair g (pair c0 (pair c0 (pair c0 c0)))))))) (pair (cons 1u nil) (pair (cons 2u nil) (pair (cons 3u nil) (cons 4u nil))))
