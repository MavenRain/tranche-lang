-- Proofs that are none. `evidence n` is none at n = 18446744073709551615
-- (natAdd overflows), and each entry reads its path at i1, so the none
-- reaches the result. At other n each entry gives 7.
def baseProof : Path Nat 0 0 := refl

def evidence : Nat -> Option (Path Nat 0 0) :=
  fun n => map (fun (s : Nat) => flagIf (natEq s 0) baseProof baseProof) (natAdd n 1)

def proofMove : Nat -> Option Nat :=
  fun n => bind (evidence n) (fun (p : Path Nat 0 0) => natAdd (p @ i1) 7)

def proofSymm : Nat -> Option Nat :=
  fun n => bind (evidence n) (fun (p : Path Nat 0 0) => natAdd (sym p @ i1) 7)

def proofTrans : Nat -> Option Nat :=
  fun n => bind (evidence n) (fun (p : Path Nat 0 0) => natAdd (trans Nat 0 0 0 baseProof p @ i1) 7)

def proofCong : Nat -> Option Nat :=
  fun n => bind (evidence n) (fun (p : Path Nat 0 0) => natAdd (cong (fun (x : Nat) => x) p @ i1) 7)
