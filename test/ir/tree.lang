-- A run-time fmMul without a static fmEta side refuses (REFUSE_RUNTIME_TREE,
-- cairn-lang S8, Q-S8-10), here under the fold of len. The Nat fold that
-- builds the tree is an upTo 7 fold: a run-time Nat fold refuses
-- REFUSE_UNBOUNDED first (Q-S3-28).
def t : (n : Nat) -> Option Nat :=
  fun (n : Nat) => bind (upTo 7 (fun (m : FreeMon Nat) => fmMul Nat m m) (fmUnit Nat) n) (fun (m : FreeMon Nat) => len Nat m)
