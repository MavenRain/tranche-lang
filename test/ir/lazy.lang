-- A lazy none. The second field of the pair is none after two steps (natAdd
-- overflows), but the entry reads only the first field. `langc eval lazy 3`
-- gives 3. The fold is upTo 7: above 7 steps the result is none.
def lazy : (n : Nat) -> Option Nat :=
  fun (n : Nat) => bind (upTo 7 (fun (p : Prod (Option Nat) (Option Nat)) => pair (bind (first p) (fun (a : Nat) => natAdd a 1)) (bind (second p) (fun (b : Nat) => natAdd b 9223372036854775807))) (pair (some 0) (some 2)) n) (fun (p : Prod (Option Nat) (Option Nat)) => first p)
