-- REFUSE_LOWER (S8 C3, Q-S8-30): the rows of transferVerify come from an
-- option on nonZero x, and x is the input of ask. Thus the rows term is
-- not closed, and the lowering has no static table. The fix gives the
-- closed def tableRows.
def R : Claims -> Claims -> Option Units :=
  fun (h : Claims) (k : Claims) => fold none (fold none (fold none (fold none (some (unitsOf 3)) (claimStatus k)) none (claimJuris k)) (claimStatus h)) none (claimJuris h)

def table : List (Prod (Prod Claims Claims) Units) := rTable R

def tableRows : Rows := rowsOf table

